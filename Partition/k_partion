class Main {
    public static void main(String[] args) {
        int[] arr={2, 1, 5, 5, 6};
        int k=3;
        int sum=0;
        for(int i=0;i<arr.length;i++){
             sum+=arr[i];
        }
        if(sum%k!=0){
            System.out.println("Not possible");
        }
        int[] bucket=new int[k];
        target=sum/k;
     System.out.println(   solve(arr,bucket,0));
       
    }
    static int target;
    public static boolean solve(int[] arr,int[] bucket,int j){
        if(j>arr.length){
             return false;
        }
        if(j==arr.length){
             for(int i=0;i<bucket.length;i++){
                 if(bucket[i]!=target)
                   return false;
             }
             return true;
        }
        boolean ans=false;
        for(int i=0;i<bucket.length;i++){
            if(bucket[i]+arr[j]<=target){
                bucket[i]+=arr[j];
               ans= solve(arr,bucket,j+1);
                bucket[i]-=arr[j];
                if(ans==true){
                    return true;
                }
            }
        }
        return ans;
    }
}
