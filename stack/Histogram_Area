Histogram_area
https://leetcode.com/problems/largest-rectangle-in-histogram/
class Solution {
    public int largestRectangleArea(int[] heights) {
        return fun(heights);
    }
      public static int fun(int[] heights){
        Stack<Integer> next=new Stack<>();
        Stack<Integer> prev=new Stack<>();
        int[] next_smaller=new int[heights.length];
        for(int i=0;i<heights.length;i++){
              int temp=heights[i];
            
              while(!next.isEmpty()&&heights[next.peek()]>temp){
                       next_smaller[next.pop()]=i;
              }
              next.push(i);
        }
        while(!next.isEmpty()){
             next_smaller[next.pop()]=heights.length;
        }
        int[] prev_smaller=new int[heights.length];

          for(int i=heights.length-1;i>=0;i--){
              int temp=heights[i];
            
              while(!prev.isEmpty()&&heights[prev.peek()]>temp){
                       prev_smaller[prev.pop()]=i;
              }
              prev.push(i);
        }
         while(!prev.isEmpty()){
             prev_smaller[prev.pop()]=-1;
        }
        for(int i=0;i<heights.length;i++){
            System.out.println(heights[i]+" "+next_smaller[i]+" "+prev_smaller[i]);
        }
        int max=0;
        for(int i=0;i<heights.length;i++){
           int width=next_smaller[i]-prev_smaller[i]-1;
           max=Math.max(max,width*heights[i]);
        }
        return max;
      }
}
