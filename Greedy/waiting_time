class Solution {
    static int solve(int bt[]) {
        // code here
        return fun(bt);
    }
     public static int fun(int[] bt){
        PriorityQueue<Integer> pq=new PriorityQueue<>();
        for(int i=0;i<bt.length;i++){
            pq.add(bt[i]);
        }
        int wait=0;
        int totaltime=0;
        int count=0;
        while(!pq.isEmpty()){
              wait+=totaltime;
              int t=pq.poll();
              totaltime+=t;
              
        }
      
         return wait/bt.length;
    }
}
