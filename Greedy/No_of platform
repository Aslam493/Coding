class Solution {
    public int minPlatform(int arr[], int dep[]) {
        //  code here
    return fun(arr,dep);
    }
    public static int fun(int[] arr,int[] dep){
        Arrays.sort(arr);
        Arrays.sort(dep);
        int max=0;
        int total=0;
        int i=0;
        int j=0;
        while(i<arr.length&&j<dep.length){
            if(arr[i]<=dep[j]){
                total++;
                i++;
            }
             else if (dep[j]<arr[i]){
                 total--;
                 j++;
            }
            else if( dep[j]>arr[i]){
                total++;
                i++;
            }
            max=Math.max(max,total);
        }
        return max;
    }
}
