https://leetcode.com/problems/jump-game-ii/
import java.util.*;

class Solution {

    static int[] dp;

    public int jump(int[] nums) {

        dp = new int[nums.length];

        Arrays.fill(dp, -1);

        return fun(nums, 0);
    }

    public static int fun(int[] nums, int i) {

        // reached last index
        if(i >= nums.length - 1) {
            return 0;
        }

        // already calculated
        if(dp[i] != -1) {
            return dp[i];
        }

        int min = Integer.MAX_VALUE;

        int jump = nums[i];

        // try all possible jumps
        for(int j = 1; j <= jump; j++) {

            // boundary check
            if(i + j <nums.length) {

                int ans = fun(nums, i + j);
                   if(ans !=Integer.MAX_VALUE)
                min = Math.min(min, ans + 1);
            }
        }

        dp[i] = min;

        return dp[i];
    }
}
