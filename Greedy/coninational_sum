https://www.geeksforgeeks.org/problems/maximum-sum-combination/1
class Solution {
    public ArrayList<Integer> topKSumPairs(int[] a, int[] b, int k) {
        // code here
        Arrays.sort(a);
        Arrays.sort(b);
        HashSet<String> set=new HashSet<>();
        PriorityQueue<pair> pq=new PriorityQueue<>((a1,b1)->(b1.sum-a1.sum));
        pq.add(new pair(a[a.length-1]+b[b.length-1],a.length-1,b.length-1));
        set.add((a.length-1)+","+(b.length-1));
        ArrayList<Integer> ll=new ArrayList<>();
        while(k>0){
          pair temp=pq.poll();
          ll.add(temp.sum);
          if(temp.i-1>=0){
              if(!set.contains((temp.i-1)+","+temp.j)){
              pq.add(new pair(a[temp.i-1]+b[temp.j],temp.i-1,temp.j));
              set.add((temp.i-1)+","+temp.j);}
          }
        
       
          if(temp.j-1>=0){
              if(!set.contains(temp.i+","+(temp.j-1))){
              pq.add(new pair(a[temp.i]+b[temp.j-1],temp.i,temp.j-1));
              set.add(temp.i+","+(temp.j-1));}
          }
            k--;
        }
        return ll;
    }
   
    
static class pair{
        int sum;
        int i;
        int j;
        pair(int sum,int i,int j){
            this.sum=sum;
            this.i=i;
            this.j=j;
        }
    }}
